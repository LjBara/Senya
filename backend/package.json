{
  "name": "senyamatika-backend",
  "version": "1.0.0",
  "description": "Backend API for SenyamatiKard Teacher and Admin Portal",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env.local dist/server.js",
    "db:init": "tsx src/db/init-sqlite.ts"
  },
  "keywords": ["education", "api", "backend"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "sql.js": "^1.10.3",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "csv-writer": "^1.6.0",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.5",
    "@types/sql.js": "^1.4.9",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
