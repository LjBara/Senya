# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senyamatika
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS
CORS_ORIGIN=http://localhost:5173

# Google Gemini (AI quiz generation)
GEMINI_API_KEY=
# Optional; default in code is gemini-2.0-flash (gemini-1.5-flash often 404s on v1beta).
GEMINI_MODEL=

# Note: server loads .env via dotenv, not .env.local. To run locally with .env.local:
#   npm run start:local
# (after npm run build), or merge vars into a file named .env.
