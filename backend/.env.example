# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senyamatika
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS
CORS_ORIGIN=http://localhost:5173

# Google Gemini (AI quiz generation)
GEMINI_API_KEY=
# Optional; default is gemini-2.5-flash (free tier). gemini-2.0-flash often has limit:0 on free tier.
# Higher throughput on free tier: GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL=

# Local overrides: create .env.local (gitignored) with GEMINI_API_KEY etc.; it is loaded after .env.
